# Kopiere diese Datei nach .env und fülle deine Werte aus.
# Für Production nutze `wrangler secret put <NAME>` (nicht in .env speichern).

# Lightroom Share (öffentlich, kann in .env bleiben)
# Fallback-Galerie der Startseite und gleichzeitig die FamilyStory-Galerie.
PORTFOLIO_LIGHTROOM_SHARE_URL=https://lightroom.adobe.com/shares/YOUR_SHARE_ID

# Galerie pro Story (JSON, ein Eintrag je Story-Key).
# Fehlt ein Key, zeigt die Story-Seite "Für diese Story kommen bald Bilder."
# Für Production: npx wrangler secret put LIGHTROOM_SHARES
# LIGHTROOM_SHARES={"familystory":"https://lightroom.adobe.com/shares/…","pregnancystory":"…","birthstory":"…","lovestory":"…","yourstory":"…"}

# Photographer contact (build-time, VITE_ prefix)
VITE_PHOTOGRAPHER_NAME="Kateryna Hohol"
VITE_PHOTOGRAPHER_BRAND="FAMILIENSTORY"
VITE_PHOTOGRAPHER_STREET="Rosenhof 7"
VITE_PHOTOGRAPHER_PLZ="09111"
VITE_PHOTOGRAPHER_ORT="Chemnitz"
VITE_PHOTOGRAPHER_EMAIL="hoholkateryna@gmail.com"
VITE_PHOTOGRAPHER_WHATSAPP="+49 176 64094869"
VITE_PHOTOGRAPHER_INSTAGRAM="@kateryna.familienstory"
VITE_PHOTOGRAPHER_INSTAGRAM_URL="https://instagram.com/kateryna.familienstory"
VITE_WHATSAPP_MESSAGE="Hallo Kateryna, ich interessiere mich für ein Fotoshooting und würde gern mehr erfahren."

# Admin credentials (local dev only — production via wrangler secrets)
ADMIN_NAME="kateryna"
ADMIN_PASSWORD=""
SESSION_SECRET=""
GALLERY_PAYLOAD_KEY=""
GOOGLE_DRIVE_API_KEY=""
